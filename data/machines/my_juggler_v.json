  "input_rules": {
    "modes": [
      {
        "id": "simple",
        "label": "簡易モード",
        "uses": ["big_total", "reg_total", "grape"]
      },
      {
        "id": "detail",
        "label": "詳細モード",
        "uses": ["solo_big", "cherry_big", "solo_reg", "cherry_reg", "grape"],
        "notes": "内訳を使う場合、合計(big_total/reg_total)は二重計上になるため尤度計算に使わない。"
      }
    ],
    "validation": [
      "詳細モードでは 単独REG + チェリー重複REG の回数合計がREG総数と一致すること(単独BIG側も同様)。",
      "内訳確率の合成値は公表合算値と厳密には一致しない(app_estimate由来の誤差)。整合チェックは回数ベースで行い、確率の突き合わせには使わない。"
    ]
  },
  "excluded_elements": [
    {
      "id": "corner_cherry",
      "label": "角チェリー(非重複)",
      "reason": "設定1と6で1/38.1〜1/35.1と差が小さく、判別寄与が低いため初期実装から除外。"
    },
    {
      "id": "special_yaku",
      "label": "特殊役A〜D",
      "reason": "出現率が1万分の1以下で1日の試行では情報量がほぼゼロのため除外。"
    }
  ]
